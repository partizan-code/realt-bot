# Скопируй в .env и заполни реальными значениями
# Не добавляй .env в git!

# TOKEN= токен ТГ бота
# ADMIN_ID= ID админа (можно узнать через @userinfobot)
# MINSK_CH_ID= ID канала Минск (можно узнать через @userinfobot)
# GOMEL_CH_ID= ID канала Гомель (можно узнать через @userinfobot)
# MOGILEV_CH_ID= ID канала Могилев (можно узнать через @userinfobot)
# VITEBSK_CH_ID= ID канала Витебск (можно узнать через @userinfobot)
# GRODNO_CH_ID= ID канала Гродно (можно узнать через @userinfobot)
# BREST_CH_ID= ID канала Брест (можно узнать через @userinfobot)